# Copy this to `.env` and fill in your values. `.env` is gitignored.
# Used by the `mustcpc` CLI. Nothing here is committed.

# --- VPS access (system ssh/scp) ---
MUSTCPC_VPS_HOST=
MUSTCPC_VPS_USER=ubuntu
MUSTCPC_VPS_PORT=22
# Optional: path to your private key. Leave empty to use ssh-agent / ~/.ssh/config.
MUSTCPC_VPS_KEY=~/.ssh/id_rsa
# Remote directory where videos + upload bundle live.
MUSTCPC_VPS_WORKDIR=/home/ubuntu/mustcpc-videos
MUSTCPC_VPS_PYTHON=python3

# --- SharePoint (runs on your PC, home IP — MUST blocks cloud IPs) ---
MUSTCPC_MUST_PROFILE_DIR=data/must-profile
MUSTCPC_MUST_STATE_FILE=data/must-state.json
MUSTCPC_MUST_START_URL=https://mustedueg.sharepoint.com/sites/MUSTCPC27

# --- YouTube (OAuth happens locally, token is pushed to the VPS) ---
MUSTCPC_YT_CLIENT_SECRET=data/client_secret.json
MUSTCPC_YT_TOKEN_FILE=data/youtube-token.json
MUSTCPC_YT_CHANNEL_ID=
MUSTCPC_YT_PRIVACY_DEFAULT=unlisted
